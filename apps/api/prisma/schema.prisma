generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------
// ENUMS
// -----------------------------------------------

enum UserRole {
  CUSTOMER
  DELIVERY
  OPERATOR
  MANAGER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PLACED
  CONFIRMED
  DELIVERY_ASSIGNED
  PICKUP_IN_PROGRESS
  RECEIVED_AT_CENTER
  WASHING_IN_PROGRESS
  WASHING_COMPLETED
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REJECTED
}

enum DeliveryType {
  PICKUP
  RETURN
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum WashingStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TELEBIRR
  CBE_BIRR
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentKind {
  DEPOSIT
  FINAL
}

// -----------------------------------------------
// AUTHENTICATION AND USERS
// -----------------------------------------------

model User {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String?
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer?
  employee Employee?

  notifications       Notification[]
  statusChanges       OrderStatusHistory[]
  auditLogs           AuditLog[]
  recordedPayments    Payment[]            @relation("PaymentRecorder")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  idempotencyRecords  IdempotencyRecord[]
  fileAssets          FileAsset[]

  @@index([role, status])
  @@index([createdAt])
}

// -----------------------------------------------
// CUSTOMERS
// -----------------------------------------------

model Customer {
  id     String @id @default(cuid())
  userId String @unique

  dateOfBirth DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses Address[]
  shoes     Shoe[]
  orders    Order[]
  ratings   Rating[]

  @@index([createdAt])
}

// -----------------------------------------------
// EMPLOYEES
// -----------------------------------------------

model Employee {
  id     String @id @default(cuid())
  userId String @unique

  employeeCode String         @unique
  status       EmployeeStatus @default(ACTIVE)
  hireDate     DateTime?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchMemberships  BranchEmployee[]
  assignedDeliveries Delivery[]       @relation("DeliveryAssignee")
  washingTasks       WashingTask[]    @relation("WashingOperator")
  inspections        ShoeInspection[] @relation("ShoeInspector")

  @@index([status])
}

// -----------------------------------------------
// BRANCHES / WASHING CENTERS
// -----------------------------------------------

model Branch {
  id        String       @id @default(cuid())
  name      String
  code      String       @unique
  phone     String?
  email     String?
  address   String
  city      String
  subCity   String?
  woreda    String?
  latitude  Float?
  longitude Float?
  status    BranchStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees    BranchEmployee[]
  services     BranchService[]
  orders       Order[]
  deliveries   Delivery[]
  washingTasks WashingTask[]

  @@index([status])
  @@index([city])
}

// Connects employees to branches.
// An employee can work at more than one branch.

model BranchEmployee {
  id         String   @id @default(cuid())
  branchId   String
  employeeId String
  assignedAt DateTime @default(now())

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([branchId, employeeId])
  @@index([employeeId])
}

// -----------------------------------------------
// CUSTOMER ADDRESSES
// -----------------------------------------------

model Address {
  id         String @id @default(cuid())
  customerId String

  label         String?
  recipientName String?
  phone         String?
  addressLine   String
  city          String
  subCity       String?
  woreda        String?
  houseNumber   String?
  landmark      String?
  latitude      Float?
  longitude     Float?
  isDefault     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pickupOrders Order[]    @relation("OrderPickupAddress")
  returnOrders Order[]    @relation("OrderReturnAddress")
  deliveries   Delivery[]

  @@index([customerId])
}

// -----------------------------------------------
// CUSTOMER SHOES
// -----------------------------------------------

model Shoe {
  id         String @id @default(cuid())
  customerId String

  brand          String?
  model          String?
  category       String
  color          String?
  description    String?
  referencePhoto String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([customerId])
}

// -----------------------------------------------
// CLEANING SERVICES
// -----------------------------------------------

model Service {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true)

  estimatedDurationMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchServices BranchService[]

  @@index([isActive])
}

// A service can have different prices at different branches.

model BranchService {
  id        String @id @default(cuid())
  branchId  String
  serviceId String

  price    Decimal @db.Decimal(12, 2)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service    Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@unique([branchId, serviceId])
  @@index([serviceId])
  @@index([branchId, isActive])
}

// -----------------------------------------------
// ORDERS
// -----------------------------------------------

model Order {
  id          String @id @default(cuid())
  bookingCode String @unique

  customerId      String
  branchId        String?
  pickupAddressId String
  returnAddressId String?

  status OrderStatus @default(PLACED)

  subtotal    Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  deliveryFee Decimal @default(0) @db.Decimal(12, 2)
  tax         Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @default(0) @db.Decimal(12, 2)
  currency    String  @default("ETB")

  customerNotes String?
  internalNotes String?

  placedAt    DateTime  @default(now())
  confirmedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)

  pickupAddress Address  @relation("OrderPickupAddress", fields: [pickupAddressId], references: [id], onDelete: Restrict)
  returnAddress Address? @relation("OrderReturnAddress", fields: [returnAddressId], references: [id], onDelete: Restrict)

  items         OrderItem[]
  deliveries    Delivery[]
  washingTasks  WashingTask[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]
  rating        Rating?

  @@index([customerId, createdAt])
  @@index([branchId, status])
  @@index([status, createdAt])
  @@index([bookingCode])
}

// -----------------------------------------------
// INDIVIDUAL SHOES IN AN ORDER
// -----------------------------------------------

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  shoeId          String?
  branchServiceId String

  // Price and service name snapshots preserve order history.
  serviceName String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int     @default(1)
  totalPrice  Decimal @db.Decimal(12, 2)

  shoeBrand      String?
  shoeModel      String?
  shoeCategory   String
  shoeColor      String?
  conditionNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shoe          Shoe?         @relation(fields: [shoeId], references: [id], onDelete: SetNull)
  branchService BranchService @relation(fields: [branchServiceId], references: [id], onDelete: Restrict)

  washingTask WashingTask?
  inspection  ShoeInspection?

  @@index([orderId])
  @@index([branchServiceId])
  @@index([shoeId])
}

// -----------------------------------------------
// PICKUP AND RETURN DELIVERIES
// -----------------------------------------------

model Delivery {
  id       String @id @default(cuid())
  orderId  String
  branchId String

  employeeId String?
  addressId  String?

  type   DeliveryType
  status DeliveryStatus @default(PENDING)

  scheduledAt DateTime?
  assignedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  notes         String?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  employee Employee? @relation("DeliveryAssignee", fields: [employeeId], references: [id], onDelete: SetNull)
  address  Address?  @relation(fields: [addressId], references: [id], onDelete: SetNull)

  @@unique([orderId, type])
  @@index([employeeId, status])
  @@index([branchId, status])
  @@index([scheduledAt])
}

// -----------------------------------------------
// WASHING TASKS
// One task per order item.
// -----------------------------------------------

model WashingTask {
  id          String @id @default(cuid())
  orderId     String
  orderItemId String @unique
  branchId    String

  operatorId String?
  status     WashingStatus @default(PENDING)

  startedAt   DateTime?
  completedAt DateTime?

  instructions String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  operator  Employee? @relation("WashingOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([branchId, status])
  @@index([operatorId, status])
}

// -----------------------------------------------
// SHOE CONDITION INSPECTIONS
// -----------------------------------------------

model ShoeInspection {
  id          String @id @default(cuid())
  orderItemId String @unique

  inspectorId String?

  conditionBefore String?
  conditionAfter  String?
  notes           String?

  beforePhotos String[] @default([])
  afterPhotos  String[] @default([])

  inspectedAt DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  inspector Employee? @relation("ShoeInspector", fields: [inspectorId], references: [id], onDelete: SetNull)

  @@index([inspectorId])
}

// -----------------------------------------------
// PAYMENTS
// -----------------------------------------------

model Payment {
  id      String @id @default(cuid())
  orderId String

  recordedByUserId String?

  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("ETB")
  kind     PaymentKind   @default(DEPOSIT)
  method   PaymentMethod
  status   PaymentStatus @default(PENDING)

  provider             String?
  transactionReference String? @unique
  providerReference    String?
  notes                String?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  recordedBy User? @relation("PaymentRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, status])
  @@index([createdAt])
}

model Rating {
  id         String @id @default(cuid())
  orderId    String @unique
  customerId String

  score   Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

// -----------------------------------------------
// ORDER STATUS HISTORY
// -----------------------------------------------

model OrderStatusHistory {
  id      String @id @default(cuid())
  orderId String

  changedByUserId String?

  previousStatus OrderStatus?
  newStatus      OrderStatus

  note      String?
  createdAt DateTime @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([changedByUserId])
}

// -----------------------------------------------
// NOTIFICATIONS
// -----------------------------------------------

model Notification {
  id     String @id @default(cuid())
  userId String

  title   String
  message String
  type    String?

  data Json?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

// -----------------------------------------------
// AUDIT LOGS
// -----------------------------------------------

model AuditLog {
  id String @id @default(cuid())

  actorUserId String?

  action      String
  entityType  String
  entityId    String?
  description String?
  metadata    Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// -----------------------------------------------
// TOKENS, IDEMPOTENCY AND FILES
// -----------------------------------------------

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model IdempotencyRecord {
  id           String   @id @default(cuid())
  key          String   @unique
  userId       String
  scope        String
  requestHash  String
  responseJson Json
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scope])
  @@index([expiresAt])
}

model FileAsset {
  id               String   @id @default(cuid())
  objectKey        String   @unique
  bucket           String
  contentType      String
  sizeBytes        Int
  ownerUserId      String
  entityType       String?
  entityId         String?
  originalFileName String?
  createdAt        DateTime @default(now())

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, createdAt])
  @@index([entityType, entityId])
}
